rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /perfis/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /parcerias/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /conteudos/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
