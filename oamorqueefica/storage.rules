rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de perfil: cada pessoa escreve apenas na própria pasta.
    match /perfis/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Formato antigo (arquivo solto em /perfis) — mantido para não quebrar links.
    match /perfis/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /parcerias/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /conteudos/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Áudios de acolhimento enviados pelo painel: o app grava em
    // audiosAcolhimento/ e o painel web em audios/. Sem estas regras o upload é
    // recusado assim que as regras forem publicadas.
    match /audiosAcolhimento/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /audios/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Vídeos de apresentação enviados pelo painel (até 500 MB, só vídeo).
    match /videos/{file} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
      allow create, update: if request.auth != null
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Mesmo critério de isAdmin() em firestore.rules: e-mails das
    // administradoras ou role 'admin' no perfil (leitura do Firestore).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in [
          'carla.zambi.psi@gmail.com',
          'larissapjaniques@gmail.com'
        ] ||
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Produtos Atravessia: imagens (até 10 MB) e vídeos (até 500 MB) dos itens
    // de divulgação. Leitura para quem está logada; envio e exclusão só admin.
    match /produtos/{file} {
      allow read: if request.auth != null;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && (
        (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/.*') && request.resource.size < 500 * 1024 * 1024)
      );
    }

    // Atravessia Artes: imagens geradas por IA (gravadas pelas Cloud Functions,
    // que ignoram estas regras) e artes finalizadas no compositor do painel
    // (até 15 MB, só imagem). Leitura e exclusão só admin.
    match /artes/{file} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Afiliados: fotos dos produtos da vitrine (até 10 MB, só imagem).
    // Leitura aberta (a foto aparece no app); envio e exclusão só admin.
    match /afiliados/{file} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Comprovantes de compra do cashback de afiliados (até 8 MB, só imagem).
    // Cada usuária envia apenas na própria pasta e não substitui nem apaga
    // depois de enviado; leitura só dela e das administradoras.
    match /comprovantesAfiliados/{userId}/{file} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }

    // Cursos Atravessia: capas dos cursos e fotos dos profissionais (até 10 MB,
    // só imagem). Leitura pública (a capa também aparece na página de
    // pagamento da Stripe e no portal do profissional); envio só admin.
    match /cursos/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Imobiliárias ("Lar e recomeço"): logos, capas, fotos de imóveis e de
    // arquitetos (até 10 MB, só imagem). Leitura para quem está logado; envio só admin.
    match /imoveis/{allPaths=**} {
      allow read: if request.auth != null;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Comprovantes de repasse aos profissionais (imagem ou PDF, até 10 MB).
    // Leitura e envio só admin; o profissional abre pelo link com token que
    // aparece no portal dele (fora da listagem pública).
    match /repassesComprovantes/{profId}/{file} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
  }
}
