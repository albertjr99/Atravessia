rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de perfil: cada pessoa escreve apenas na própria pasta.
    match /perfis/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Formato antigo (arquivo solto em /perfis) — mantido para não quebrar links.
    match /perfis/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /parcerias/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /conteudos/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
