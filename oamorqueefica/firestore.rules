rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'carla.zambi.psi@gmail.com',
          'larissapjaniques@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Perfil da usuária + suas subcoleções (check-ins, memórias, cartas, etc.)
    match /usuarios/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plano', 'role', 'stripeCustomerId', 'stripeSubscriptionId'])
        ) || isAdmin()
      );
      allow delete: if isAdmin();

      match /{subcollection}/{docId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Consulta por grupo de coleção (collectionGroup) sobre os check-ins de todas
    // as usuárias — usada pelo Dashboard e pelos relatórios administrativos.
    // Sem esta regra a query falha e os indicadores ficam zerados.
    match /{path=**}/checkins/{docId} {
      allow read: if isAdmin();
    }

    // Mesmo caso das vitórias: a regra de subcoleção acima não vale para
    // consultas por grupo de coleção, então os relatórios precisam desta.
    match /{path=**}/vitorias/{docId} {
      allow read: if isAdmin();
    }

    // Frases e reflexões do dia — leitura para todas, escrita só admin
    match /frases/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Biblioteca de conteúdos (áudios, documentos, links) — leitura para todas, escrita só admin
    match /conteudos/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Notificações editoriais — leitura para todas, escrita só admin
    match /notificacoesEditoriais/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Jornadas criadas pela admin — leitura para todas, escrita só admin
    match /jornadas/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Opções de pequenas vitórias — leitura para todas, escrita só admin
    match /vitoriasOpcoes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Parcerias e benefícios — leitura para todas, escrita só admin
    match /parcerias/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Configurações globais (preços, mensagens de relatório) — leitura para todas, escrita só admin
    match /configuracoes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Áudios de acolhimento por emoção — leitura para todas, escrita só admin
    match /audiosAcolhimento/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Itens da seção "Continue a Travessia" — leitura para todas, escrita só admin
    match /travessiaItens/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Planos do aplicativo — leitura para todas, escrita só admin
    match /planos/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Módulo de Benefícios/Cupons com comissão ("Cuide-se") ──────────────
    // O cálculo financeiro (desconto, comissão) só pode acontecer nas Cloud
    // Functions (functions/index.js), que usam o Admin SDK e ignoram estas
    // regras. Por isso a escrita direta pelo cliente é sempre negada — mesmo
    // para a administradora — evitando que qualquer app (inclusive o painel
    // do parceiro, que nem autentica) grave um valor de comissão manipulado.

    // Voucher gerado pela usuária. Ela só pode LER o seu; a admin lê todos.
    // O parceiro nunca lê este documento diretamente — só via Cloud Function,
    // que devolve apenas o necessário para validar (sem dados da usuária).
    match /vouchers/{docId} {
      allow read: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Registro financeiro de uma utilização confirmada pelo parceiro.
    match /resgates/{docId} {
      allow read: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Fechamento periódico (settlement) de comissões por parceria.
    match /fechamentos/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Trilha de auditoria de todo o módulo — somente leitura pela admin.
    match /auditoriaBeneficios/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
