rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'carla.zambi.psi@gmail.com',
          'larissapjaniques@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Perfil da usuária + suas subcoleções (check-ins, memórias, cartas, etc.)
    match /usuarios/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plano', 'role', 'stripeCustomerId', 'stripeSubscriptionId'])
        ) || isAdmin()
      );
      allow delete: if isAdmin();

      match /{subcollection}/{docId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        // "cursos" é o acesso aos cursos comprados: só o servidor libera
        // (ver o bloco usuarios/{uid}/cursos abaixo).
        allow write: if isSignedIn() && request.auth.uid == userId && subcollection != 'cursos';
      }

      // Cursos Atravessia: o acesso é criado pelo webhook do Stripe. A usuária
      // só pode atualizar o próprio progresso (aulas concluídas, última aula).
      match /cursos/{cursoId} {
        allow update: if isSignedIn() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['progresso', 'ultimaAulaId', 'progressoEm']);
      }
    }

    // Consulta por grupo de coleção (collectionGroup) sobre os check-ins de todas
    // as usuárias — usada pelo Dashboard e pelos relatórios administrativos.
    // Sem esta regra a query falha e os indicadores ficam zerados.
    match /{path=**}/checkins/{docId} {
      allow read: if isAdmin();
    }

    // Mesmo caso das vitórias: a regra de subcoleção acima não vale para
    // consultas por grupo de coleção, então os relatórios precisam desta.
    match /{path=**}/vitorias/{docId} {
      allow read: if isAdmin();
    }

    // Frases e reflexões do dia — leitura para todas, escrita só admin
    match /frases/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Biblioteca de conteúdos (áudios, documentos, links) — leitura para todas, escrita só admin
    match /conteudos/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Produtos Atravessia — itens de divulgação (texto, imagem, link, vídeo) — leitura para todas, escrita só admin
    match /produtosItens/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Notificações editoriais — leitura para todas, escrita só admin
    match /notificacoesEditoriais/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Jornadas criadas pela admin — leitura para todas, escrita só admin
    match /jornadas/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Opções de pequenas vitórias — leitura para todas, escrita só admin
    match /vitoriasOpcoes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Parcerias e benefícios — leitura para todas, escrita só admin
    match /parcerias/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Configurações globais (preços, mensagens de relatório) — leitura para todas, escrita só admin
    match /configuracoes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Atravessia Artes: galeria de artes geradas por IA (painel). Só as
    // administradoras leem e editam (favoritar, salvar do compositor); a
    // geração em si grava pelas Cloud Functions (Admin SDK).
    match /artes/{docId} {
      allow read, write: if isAdmin();
    }

    // Áudios de acolhimento por emoção — leitura para todas, escrita só admin
    match /audiosAcolhimento/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Itens da seção "Continue a Travessia" — leitura para todas, escrita só admin
    match /travessiaItens/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Planos do aplicativo — leitura para todas, escrita só admin
    match /planos/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Indicações Atravessia (produtos com link de afiliado da Amazon) —
    // leitura para todas, escrita só admin. Os cliques são contados pela
    // Cloud Function registrarClique.
    match /indicacoes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Cashback: créditos, usos e estornos. Cada usuária só lê os seus; a
    // escrita é exclusiva das Cloud Functions (Admin SDK), para ninguém
    // conseguir se dar crédito pelo app.
    match /cashback/{docId} {
      allow read: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Módulo de Benefícios/Cupons com comissão ("Cuide-se") ──────────────
    // O cálculo financeiro (desconto, comissão) só pode acontecer nas Cloud
    // Functions (functions/index.js), que usam o Admin SDK e ignoram estas
    // regras. Por isso a escrita direta pelo cliente é sempre negada — mesmo
    // para a administradora — evitando que qualquer app (inclusive o painel
    // do parceiro, que nem autentica) grave um valor de comissão manipulado.

    // Voucher gerado pela usuária. Ela só pode LER o seu; a admin lê todos.
    // O parceiro nunca lê este documento diretamente — só via Cloud Function,
    // que devolve apenas o necessário para validar (sem dados da usuária).
    match /vouchers/{docId} {
      allow read: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Registro financeiro de uma utilização confirmada pelo parceiro.
    match /resgates/{docId} {
      allow read: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Fechamento periódico (settlement) de comissões por parceria.
    match /fechamentos/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Trilha de auditoria de todo o módulo — somente leitura pela admin.
    match /auditoriaBeneficios/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── AFILIADOS (cashback de compras pelos links de afiliado) ────────────
    // Dados internos de cada item (comissão do app, preço de referência).
    // A usuária nunca lê: só as administradoras.
    match /afiliadosPrivado/{itemId} {
      allow read, write: if isAdmin();
    }

    // Rastreio do clique (prova de que a compra começou pelo app). Gravado só
    // pela Cloud Function registrarCliqueAfiliado; a usuária lê os seus.
    match /rastreiosAfiliados/{docId} {
      allow read: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Pedidos de cashback (nº do pedido, valor, comprovante). Criados pela
    // função enviarPedidoCashbackAfiliado e analisados por
    // analisarPedidoCashbackAfiliado: depois de enviado, ninguém altera o
    // status pelo app — nem a usuária, nem o painel (o crédito sai no servidor).
    match /pedidosCashbackAfiliado/{docId} {
      allow read: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ===== Cursos Atravessia =====
    // Vitrine: leitura para quem está logada; criação e edição só admin.
    match /cursos/{cursoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // Perfil público do profissional (sem e-mail nem token do portal).
    // Gravado pela função salvarProfissional; a admin pode ativar/ocultar.
    match /profissionais/{profId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // E-mail e token do portal do profissional: só admin lê; só o servidor grava.
    match /profissionaisPrivado/{profId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Vendas: criadas só pelo webhook do Stripe; valores congelados.
    match /matriculas/{matriculaId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    // Histórico de repasses aos profissionais (função fecharRepasse).
    match /repasses/{repasseId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
