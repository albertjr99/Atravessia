{
  "expo": {
    "name": "Atravessia",
    "slug": "atravessia",
    "version": "1.23.0",
    "sdkVersion": "54.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "dark-content"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atravessia",
      "infoPlist": {
        "NSCameraUsageDescription": "O Atravessia usa a câmera nos atendimentos online por vídeo, só quando você entra na sala.",
        "NSMicrophoneUsageDescription": "O Atravessia usa o microfone nos atendimentos online por vídeo, só quando você entra na sala.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F3"
      },
      "package": "com.atravessia",
      "versionCode": 53,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Atravessia",
      "lang": "pt-BR",
      "shortName": "Atravessia",
      "themeColor": "#45358A",
      "backgroundColor": "#F6F1EE",
      "description": "Acolhimento para quem atravessa o luto."
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-vazio.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F3"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso à galeria para enviar fotos e imagens."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita o uso do Face ID para entrar no app."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Atravessia usa o microfone nos atendimentos online por vídeo, só quando você entra na sala."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6B54C6",
          "androidMode": "default",
          "androidCollapsedTitle": "Atravessia",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "87497b0a-d29e-4c73-bb76-42a69cbd026f"
      }
    },
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
